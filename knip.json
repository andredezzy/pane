{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": ["defaults", "ioreg", "openssl", "swift"],
	"workspaces": {
		".": {
			"entry": [
				"native/engine/tests/run.ts",
				"native/engine/tests/scenarios/*.ts",
				"native/engine/tests/tools/*.ts"
			],
			"ignoreDependencies": ["electron"]
		}
	},
	"ignore": [
		"**/release/**",
		"**/node_modules/**",
		".claude/**",
		".cursor/**",
		"native/engine/tests/pages/**"
	]
}
