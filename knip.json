{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": [
		"clang",
		"cua-driver",
		"ditto",
		"hdiutil",
		"ioreg",
		"openssl",
		"swift",
		"xattr"
	],
	"workspaces": {
		".": {
			"entry": ["tests/scenarios/*.ts", "tests/tools/*.ts"],
			"ignoreDependencies": ["electron"]
		}
	},
	"ignore": ["tests/pages/**"]
}
