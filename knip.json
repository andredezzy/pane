{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": [
		"codesign",
		"defaults",
		"ditto",
		"hdiutil",
		"ioreg",
		"openssl",
		"swift"
	],
	"workspaces": {
		".": {
			"entry": ["tests/scenarios/*.ts", "tests/tools/*.ts"],
			"ignoreDependencies": ["electron"]
		}
	},
	"ignore": [
		"**/release/**",
		"**/node_modules/**",
		".claude/**",
		".cursor/**",
		"tests/pages/**"
	]
}
