 class LoginHandlerViewsDialog;
 
@@ -227,10 +228,23 @@ LoginHandlerViewsDialog::~LoginHandlerViewsDialog() {
 }
 
 // static
+// Pane: see pane/browser/ui/ui_hooks.h.
+std::unique_ptr<LoginHandler> (*g_pane_create_login_handler)(
+    const net::AuthChallengeInfo& auth_info,
+    content::WebContents* web_contents,
+    content::LoginDelegate::LoginAuthRequiredCallback& callback) = nullptr;
+
 std::unique_ptr<LoginHandler> LoginHandler::Create(
     const net::AuthChallengeInfo& auth_info,
     content::WebContents* web_contents,
     content::LoginDelegate::LoginAuthRequiredCallback auth_required_callback) {
+  // Pane: one of its tabs asks the app for credentials.
+  if (g_pane_create_login_handler) {
+    if (auto handler = g_pane_create_login_handler(auth_info, web_contents,
+                                                   auth_required_callback)) {
+      return handler;
+    }
+  }
   return std::make_unique<LoginHandlerViews>(auth_info, web_contents,
                                              std::move(auth_required_callback));
 }
