@@ -1502,6 +1502,15 @@ void ChromeMainDelegate::InitMacCrashReporter(
   // dylib is even loaded, to catch potential early crashes.
 
   const bool browser_process = process_type.empty();
+
+  // Pane: no crash handler, so no minidump: one held the page's address
+  // (url-chunk), and the database sat outside the encrypted data, under
+  // Chromium's default user data dir. Child processes start none either,
+  // and keep macOS's own crash reporting.
+  if (browser_process && command_line.HasSwitch("pane-hosted")) {
+    return;
+  }
+
   const bool install_from_dmg_relauncher_process =
       process_type == switches::kRelauncherProcess &&
       command_line.HasSwitch(switches::kRelauncherProcessDMGDevice);
