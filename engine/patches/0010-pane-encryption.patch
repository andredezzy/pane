@@ -0,0 +1,71 @@
+// Copyright 2026 Pane. Licensed under GPL-3.0-only.
+
+#ifndef STORAGE_BROWSER_FILE_SYSTEM_PANE_ENCRYPTED_STREAM_H_
+#define STORAGE_BROWSER_FILE_SYSTEM_PANE_ENCRYPTED_STREAM_H_
+
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/task/task_runner.h"
+#include "base/time/time.h"
+#include "storage/browser/file_system/file_stream_reader.h"
+#include "storage/browser/file_system/file_stream_writer.h"
+
+namespace disk_cache {
+class CacheFile;
+}
+
+namespace storage {
+
+// Pane: a profile's stream files (IndexedDB's blobs, the origin private file
+// system) go through the chunked format (net/disk_cache/pane_cache_hook.h),
+// since they are read and overwritten anywhere in them.
+
+// Whether `path` is one. False in a process with no such files.
+COMPONENT_EXPORT(STORAGE_BROWSER)
+bool PaneIsEncryptedFile(const base::FilePath& path);
+
+// `path` through the format, opened with `flags` (FLAG_READ is added, since a
+// partial chunk is read back to write it).
+COMPONENT_EXPORT(STORAGE_BROWSER)
+std::unique_ptr<disk_cache::CacheFile> PaneOpenEncryptedFile(
+    const base::FilePath& path,
+    uint32_t flags);
+
+std::unique_ptr<FileStreamReader> PaneCreateEncryptedReader(
+    scoped_refptr<base::TaskRunner> task_runner,
+    const base::FilePath& path,
+    int64_t initial_offset,
+    const base::Time& expected_modification_time);
+
+std::unique_ptr<FileStreamWriter> PaneCreateEncryptedWriter(
+    scoped_refptr<base::TaskRunner> task_runner,
+    const base::FilePath& path,
+    int64_t initial_offset,
+    FileStreamWriter::OpenOrCreate open_or_create);
+
+// What the disk delegate needs: a file's length as its users know it, a change
+// of it, and a plain file (wherever it is) copied in, encrypted.
+base::File::Error PaneGetEncryptedFileInfo(const base::FilePath& path,
+                                           base::File::Info* info);
+base::File::Error PaneTruncateEncryptedFile(const base::FilePath& path,
+                                            int64_t length);
+COMPONENT_EXPORT(STORAGE_BROWSER)
+base::File::Error PaneCopyInPlainFile(const base::FilePath& from,
+                                      const base::FilePath& to);
+
+// `size` bytes of `from`, from `offset`, into a new `to`, each read or written
+// through the format if it is a profile's.
+COMPONENT_EXPORT(STORAGE_BROWSER)
+base::File::Error PaneCopyFile(const base::FilePath& from,
+                               const base::FilePath& to,
+                               int64_t offset,
+                               int64_t size);
+
+}  // namespace storage
+
+#endif  // STORAGE_BROWSER_FILE_SYSTEM_PANE_ENCRYPTED_STREAM_H_
