+// Copyright 2026 Pane. Licensed under GPL-3.0-only.
+
+#ifndef NET_DISK_CACHE_PANE_CACHE_HOOK_H_
+#define NET_DISK_CACHE_PANE_CACHE_HOOK_H_
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "net/base/net_export.h"
+
+namespace disk_cache {
+
+class BackendFileOperationsFactory;
+class CacheEntryHasher;
+class CacheFile;
+
+// Pane encrypts a profile's files (pane/encryption) with Chromium's own chunked
+// format (services/network/enterprise/encryption), which //net and //storage
+// cannot depend on. It fills these in every process that writes such a file.
+struct PaneCacheHook {
+  // Whether a file at `path` is encrypted.
+  bool (*is_protected)(const base::FilePath& path);
+  // For a cache at `path`: wraps `factory` in the encrypted file operations
+  // unless `wrapped`, and gives the keyed hasher for its entries' names. False,
+  // changing nothing, for a cache that is not encrypted.
+  bool (*wrap_cache)(const base::FilePath& path,
+                     scoped_refptr<BackendFileOperationsFactory>* factory,
+                     std::unique_ptr<CacheEntryHasher>* hasher,
+                     bool wrapped);
+  // A file's content, read and written through the chunked format.
+  std::unique_ptr<CacheFile> (*wrap_file)(const base::FilePath& path,
+                                          std::unique_ptr<CacheFile> file);
+};
+
+NET_EXPORT void SetPaneCacheHook(const PaneCacheHook* hook);
+NET_EXPORT const PaneCacheHook* GetPaneCacheHook();
+
+}  // namespace disk_cache
+
+#endif  // NET_DISK_CACHE_PANE_CACHE_HOOK_H_
