diff --git a/storage/browser/file_system/pane_encrypted_stream.cc b/storage/browser/file_system/pane_encrypted_stream.cc
new file mode 100644
index 0000000000..3132f19710
--- /dev/null
+++ b/storage/browser/file_system/pane_encrypted_stream.cc
@@ -0,0 +1,427 @@
+// Copyright 2026 Pane. Licensed under GPL-3.0-only.
+
+#include "storage/browser/file_system/pane_encrypted_stream.h"
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/task/task_runner.h"
+#include "net/base/file_stream.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/disk_cache/basic_cache_file.h"
+#include "net/disk_cache/pane_cache_hook.h"
+
+namespace storage {
+
+namespace {
+
+constexpr uint32_t kOpenFlags =
+    base::File::FLAG_OPEN | base::File::FLAG_READ | base::File::FLAG_WRITE;
+
+// The open file, on the task runner: the reader and the writer each run one
+// operation at a time.
+class EncryptedFile : public base::RefCountedThreadSafe<EncryptedFile> {
+ public:
+  EncryptedFile(const base::FilePath& path, uint32_t flags)
+      : path_(path), flags_(flags) {}
+
+  // Opens on first use. FILE_OK, or why not.
+  base::File::Error Open() {
+    if (!file_) {
+      file_ = PaneOpenEncryptedFile(path_, flags_);
+    }
+    return file_->IsValid() ? base::File::FILE_OK : file_->error_details();
+  }
+
+  int ReadAt(int64_t offset, scoped_refptr<net::IOBuffer> buffer, int length) {
+    if (const base::File::Error error = Open(); error != base::File::FILE_OK) {
+      return net::FileErrorToNetError(error);
+    }
+
+    std::optional<size_t> read =
+        file_->Read(offset, buffer->first(base::checked_cast<size_t>(length)));
+    return read ? base::checked_cast<int>(*read) : net::ERR_FAILED;
+  }
+
+  int WriteAt(int64_t offset, scoped_refptr<net::IOBuffer> buffer, int length) {
+    if (const base::File::Error error = Open(); error != base::File::FILE_OK) {
+      return net::FileErrorToNetError(error);
+    }
+
+    return file_->WriteAndCheck(offset,
+                                buffer->first(base::checked_cast<size_t>(length)))
+               ? length
+               : net::ERR_FAILED;
+  }
+
+  int64_t Length() {
+    return Open() == base::File::FILE_OK ? file_->GetLength()
+                                         : net::ERR_FILE_NOT_FOUND;
+  }
+
+  int Flush() {
+    if (Open() != base::File::FILE_OK) {
+      return net::ERR_FAILED;
+    }
+
+    base::File plain(path_, base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+    return plain.IsValid() && plain.Flush() ? net::OK : net::ERR_FAILED;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<EncryptedFile>;
+  ~EncryptedFile() = default;
+
+  const base::FilePath path_;
+  const uint32_t flags_;
+  std::unique_ptr<disk_cache::CacheFile> file_;
+};
+
+class EncryptedReader : public FileStreamReader {
+ public:
+  EncryptedReader(scoped_refptr<base::TaskRunner> task_runner,
+                  const base::FilePath& path,
+                  int64_t offset,
+                  const base::Time& expected_modification_time)
+      : task_runner_(std::move(task_runner)),
+        path_(path),
+        offset_(offset),
+        expected_modification_time_(expected_modification_time),
+        file_(base::MakeRefCounted<EncryptedFile>(path, kOpenFlags)) {}
+
+  ~EncryptedReader() override {
+    task_runner_->PostTask(FROM_HERE,
+                           base::DoNothingWithBoundArgs(std::move(file_)));
+  }
+
+  int Read(net::IOBuffer* buffer,
+           int length,
+           net::CompletionOnceCallback callback) override {
+    task_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](scoped_refptr<EncryptedFile> file, base::FilePath path,
+               base::Time expected, bool verified, int64_t offset,
+               scoped_refptr<net::IOBuffer> buffer, int length) {
+              if (!verified) {
+                base::File::Info info;
+                if (!base::GetFileInfo(path, &info)) {
+                  return static_cast<int>(net::ERR_FILE_NOT_FOUND);
+                }
+                if (!VerifySnapshotTime(expected, info)) {
+                  return static_cast<int>(net::ERR_UPLOAD_FILE_CHANGED);
+                }
+              }
+              return file->ReadAt(offset, std::move(buffer), length);
+            },
+            file_, path_, expected_modification_time_, verified_, offset_,
+            base::WrapRefCounted(buffer), length),
+        base::BindOnce(&EncryptedReader::DidRead, weak_factory_.GetWeakPtr(),
+                       std::move(callback)));
+    return net::ERR_IO_PENDING;
+  }
+
+  int64_t GetLength(GetLengthCallback callback) override {
+    task_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](scoped_refptr<EncryptedFile> file, base::FilePath path,
+               base::Time expected) -> int64_t {
+              base::File::Info info;
+              if (!base::GetFileInfo(path, &info)) {
+                return net::ERR_FILE_NOT_FOUND;
+              }
+              if (!VerifySnapshotTime(expected, info)) {
+                return net::ERR_UPLOAD_FILE_CHANGED;
+              }
+              return file->Length();
+            },
+            file_, path_, expected_modification_time_),
+        base::BindOnce(
+            [](GetLengthCallback callback, int64_t length) {
+              if (length < 0) {
+                std::move(callback).Run(
+                    base::unexpected(static_cast<net::Error>(length)));
+              } else {
+                std::move(callback).Run(length);
+              }
+            },
+            std::move(callback)));
+    return net::ERR_IO_PENDING;
+  }
+
+ private:
+  void DidRead(net::CompletionOnceCallback callback, int result) {
+    if (result >= 0) {
+      verified_ = true;
+      offset_ += result;
+    }
+    std::move(callback).Run(result);
+  }
+
+  const scoped_refptr<base::TaskRunner> task_runner_;
+  const base::FilePath path_;
+  int64_t offset_;
+  const base::Time expected_modification_time_;
+  bool verified_ = false;
+  scoped_refptr<EncryptedFile> file_;
+  base::WeakPtrFactory<EncryptedReader> weak_factory_{this};
+};
+
+class EncryptedWriter : public FileStreamWriter {
+ public:
+  EncryptedWriter(scoped_refptr<base::TaskRunner> task_runner,
+                  const base::FilePath& path,
+                  int64_t offset,
+                  OpenOrCreate open_or_create)
+      : task_runner_(std::move(task_runner)),
+        offset_(offset),
+        file_(base::MakeRefCounted<EncryptedFile>(
+            path,
+            open_or_create == CREATE_NEW_FILE_ALWAYS
+                ? base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_READ |
+                      base::File::FLAG_WRITE
+                : kOpenFlags)) {}
+
+  ~EncryptedWriter() override {
+    task_runner_->PostTask(FROM_HERE,
+                           base::DoNothingWithBoundArgs(std::move(file_)));
+  }
+
+  int Write(net::IOBuffer* buffer,
+            int length,
+            net::CompletionOnceCallback callback) override {
+    has_pending_ = true;
+    task_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&EncryptedFile::WriteAt, file_, offset_,
+                       base::WrapRefCounted(buffer), length),
+        base::BindOnce(&EncryptedWriter::DidWrite, weak_factory_.GetWeakPtr(),
+                       std::move(callback)));
+    return net::ERR_IO_PENDING;
+  }
+
+  int Cancel(net::CompletionOnceCallback callback) override {
+    if (!has_pending_) {
+      return net::ERR_UNEXPECTED;
+    }
+    cancel_callback_ = std::move(callback);
+    return net::ERR_IO_PENDING;
+  }
+
+  int Flush(FlushMode, net::CompletionOnceCallback callback) override {
+    has_pending_ = true;
+    task_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&EncryptedFile::Flush, file_),
+        base::BindOnce(&EncryptedWriter::DidFlush, weak_factory_.GetWeakPtr(),
+                       std::move(callback)));
+    return net::ERR_IO_PENDING;
+  }
+
+ private:
+  bool Cancelled() {
+    has_pending_ = false;
+    if (!cancel_callback_) {
+      return false;
+    }
+    std::move(cancel_callback_).Run(net::OK);
+    return true;
+  }
+
+  void DidWrite(net::CompletionOnceCallback callback, int result) {
+    if (result >= 0) {
+      offset_ += result;
+    }
+    if (!Cancelled()) {
+      std::move(callback).Run(result);
+    }
+  }
+
+  void DidFlush(net::CompletionOnceCallback callback, int result) {
+    if (!Cancelled()) {
+      std::move(callback).Run(result);
+    }
+  }
+
+  const scoped_refptr<base::TaskRunner> task_runner_;
+  int64_t offset_;
+  scoped_refptr<EncryptedFile> file_;
+  bool has_pending_ = false;
+  net::CompletionOnceCallback cancel_callback_;
+  base::WeakPtrFactory<EncryptedWriter> weak_factory_{this};
+};
+
+}  // namespace
+
+bool PaneIsEncryptedFile(const base::FilePath& path) {
+  const disk_cache::PaneCacheHook* hook = disk_cache::GetPaneCacheHook();
+  return hook && hook->is_protected(path);
+}
+
+std::unique_ptr<disk_cache::CacheFile> PaneOpenEncryptedFile(
+    const base::FilePath& path,
+    uint32_t flags) {
+  const disk_cache::PaneCacheHook* hook = disk_cache::GetPaneCacheHook();
+  CHECK(hook);
+  return hook->wrap_file(
+      path, std::make_unique<disk_cache::BasicCacheFile>(base::File(path, flags)));
+}
+
+std::unique_ptr<FileStreamReader> PaneCreateEncryptedReader(
+    scoped_refptr<base::TaskRunner> task_runner,
+    const base::FilePath& path,
+    int64_t initial_offset,
+    const base::Time& expected_modification_time) {
+  return std::make_unique<EncryptedReader>(std::move(task_runner), path,
+                                           initial_offset,
+                                           expected_modification_time);
+}
+
+std::unique_ptr<FileStreamWriter> PaneCreateEncryptedWriter(
+    scoped_refptr<base::TaskRunner> task_runner,
+    const base::FilePath& path,
+    int64_t initial_offset,
+    FileStreamWriter::OpenOrCreate open_or_create) {
+  return std::make_unique<EncryptedWriter>(std::move(task_runner), path,
+                                           initial_offset, open_or_create);
+}
+
+base::File::Error PaneGetEncryptedFileInfo(const base::FilePath& path,
+                                           base::File::Info* info) {
+  if (!base::GetFileInfo(path, info)) {
+    return base::File::GetLastFileError();
+  }
+
+  if (info->is_directory) {
+    return base::File::FILE_OK;
+  }
+
+  std::unique_ptr<disk_cache::CacheFile> file =
+      PaneOpenEncryptedFile(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+
+  if (!file->IsValid()) {
+    return file->error_details();
+  }
+
+  info->size = file->GetLength();
+  return base::File::FILE_OK;
+}
+
+base::File::Error PaneTruncateEncryptedFile(const base::FilePath& path,
+                                            int64_t length) {
+  std::unique_ptr<disk_cache::CacheFile> file =
+      PaneOpenEncryptedFile(path, kOpenFlags);
+
+  if (!file->IsValid()) {
+    return file->error_details();
+  }
+
+  return file->SetLength(length) ? base::File::FILE_OK
+                                 : base::File::FILE_ERROR_FAILED;
+}
+
+base::File::Error PaneCopyInPlainFile(const base::FilePath& from,
+                                      const base::FilePath& to) {
+  base::File source(from, base::File::FLAG_OPEN | base::File::FLAG_READ);
+
+  if (!source.IsValid()) {
+    return source.error_details();
+  }
+
+  std::unique_ptr<disk_cache::CacheFile> target = PaneOpenEncryptedFile(
+      to, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_READ |
+              base::File::FLAG_WRITE);
+
+  if (!target->IsValid()) {
+    return target->error_details();
+  }
+
+  std::vector<uint8_t> buffer(1 << 20);
+
+  for (int64_t offset = 0;;) {
+    std::optional<size_t> read = source.Read(offset, buffer);
+
+    if (!read) {
+      return base::File::FILE_ERROR_FAILED;
+    }
+
+    if (*read == 0) {
+      return base::File::FILE_OK;
+    }
+
+    if (!target->WriteAndCheck(offset, base::span(buffer).first(*read))) {
+      return base::File::FILE_ERROR_FAILED;
+    }
+
+    offset += *read;
+  }
+}
+
+base::File::Error PaneCopyFile(const base::FilePath& from,
+                               const base::FilePath& to,
+                               int64_t offset,
+                               int64_t size) {
+  const auto open = [](const base::FilePath& path, uint32_t flags)
+      -> std::unique_ptr<disk_cache::CacheFile> {
+    return PaneIsEncryptedFile(path)
+               ? PaneOpenEncryptedFile(path, flags)
+               : std::make_unique<disk_cache::BasicCacheFile>(
+                     base::File(path, flags));
+  };
+
+  std::unique_ptr<disk_cache::CacheFile> source =
+      open(from, base::File::FLAG_OPEN | base::File::FLAG_READ);
+
+  if (!source->IsValid()) {
+    return source->error_details();
+  }
+
+  std::unique_ptr<disk_cache::CacheFile> target =
+      open(to, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_READ |
+                   base::File::FLAG_WRITE);
+
+  if (!target->IsValid()) {
+    return target->error_details();
+  }
+
+  std::vector<uint8_t> buffer(1 << 20);
+  int64_t copied = 0;
+
+  while (copied < size) {
+    const size_t wanted = static_cast<size_t>(
+        std::min<int64_t>(static_cast<int64_t>(buffer.size()), size - copied));
+    std::optional<size_t> read =
+        source->Read(offset + copied, base::span(buffer).first(wanted));
+
+    if (!read) {
+      return base::File::FILE_ERROR_FAILED;
+    }
+
+    if (*read == 0) {
+      break;
+    }
+
+    if (!target->WriteAndCheck(copied, base::span(buffer).first(*read))) {
+      return base::File::FILE_ERROR_FAILED;
+    }
+
+    copied += *read;
+  }
+
+  return base::File::FILE_OK;
+}
+
+}  // namespace storage
