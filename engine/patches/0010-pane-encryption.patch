new file mode 100644
index 0000000000..d693ea961d
--- /dev/null
+++ b/base/files/pane_file_codec.h
@@ -0,0 +1,36 @@
+// Copyright 2026 Pane. Licensed under GPL-3.0-only.
+
+#ifndef BASE_FILES_PANE_FILE_CODEC_H_
+#define BASE_FILES_PANE_FILE_CODEC_H_
+
+#include <stdint.h>
+
+#include <string>
+
+#include "base/base_export.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace base {
+
+// Pane encrypts a profile's files (pane/encryption): the ones Chromium writes
+// and reads whole come through here, so its callers see only their plaintext.
+// Each function returns false for a path it leaves alone. Nothing is set in a
+// process that has no profile's files, where this costs one load.
+struct PaneFileCodec {
+  // Seals `plaintext` for `path` into `sealed`.
+  bool (*seal)(const FilePath& path,
+               span<const uint8_t> plaintext,
+               std::string* sealed);
+  // Opens what `path` held into `plaintext`. A plain file passes as it is.
+  bool (*open)(const FilePath& path,
+               span<const uint8_t> stored,
+               std::string* plaintext);
+};
+
+BASE_EXPORT void SetPaneFileCodec(const PaneFileCodec* codec);
+BASE_EXPORT const PaneFileCodec* GetPaneFileCodec();
+
+}  // namespace base
+
+#endif  // BASE_FILES_PANE_FILE_CODEC_H_
