diff --git a/services/network/enterprise/encryption/pane_cache_hook.cc b/services/network/enterprise/encryption/pane_cache_hook.cc
new file mode 100644
index 0000000000..cbc0d0fcd5
--- /dev/null
+++ b/services/network/enterprise/encryption/pane_cache_hook.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 Pane. Licensed under GPL-3.0-only.
+
+#include "services/network/enterprise/encryption/pane_cache_hook.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "crypto/process_bound_string.h"
+#include "net/disk_cache/cache_file.h"
+#include "net/disk_cache/disk_cache.h"
+#include "net/disk_cache/pane_cache_hook.h"
+#include "pane/encryption/engine_keys.h"  // nogncheck
+#include "services/network/enterprise/encryption/encrypted_backend_file_operations_factory.h"
+#include "services/network/enterprise/encryption/encrypted_cache_entry_hasher.h"
+#include "services/network/enterprise/encryption/encrypted_cache_file.h"
+
+namespace network::enterprise_encryption {
+
+namespace {
+
+std::optional<crypto::ProcessBoundString> KeyFor(const base::FilePath& path) {
+  pane::encryption::PathVerdict verdict = pane::encryption::Classify(path);
+
+  if (verdict.kind != pane::encryption::PathKind::kEncrypted) {
+    return std::nullopt;
+  }
+
+  return crypto::ProcessBoundString(
+      std::string(base::as_string_view(verdict.keys->caches)));
+}
+
+bool IsProtected(const base::FilePath& path) {
+  return pane::encryption::Classify(path).kind ==
+         pane::encryption::PathKind::kEncrypted;
+}
+
+bool WrapCache(const base::FilePath& path,
+               scoped_refptr<disk_cache::BackendFileOperationsFactory>* factory,
+               std::unique_ptr<disk_cache::CacheEntryHasher>* hasher,
+               bool wrapped) {
+  std::optional<crypto::ProcessBoundString> key = KeyFor(path);
+
+  if (!key) {
+    return false;
+  }
+
+  if (!wrapped) {
+    scoped_refptr<disk_cache::BackendFileOperationsFactory> inner =
+        *factory ? *factory
+                 : base::MakeRefCounted<
+                       disk_cache::TrivialFileOperationsFactory>();
+    *factory = base::MakeRefCounted<EncryptedBackendFileOperationsFactory>(
+        std::move(inner), *key);
+  }
+
+  *hasher = std::make_unique<EncryptedCacheEntryHasher>(std::move(*key));
+  return true;
+}
+
+std::unique_ptr<disk_cache::CacheFile> WrapFile(
+    const base::FilePath& path,
+    std::unique_ptr<disk_cache::CacheFile> file) {
+  std::optional<crypto::ProcessBoundString> key = KeyFor(path);
+  return key ? std::make_unique<EncryptedCacheFile>(std::move(file), *key)
+             : std::move(file);
+}
+
+constexpr disk_cache::PaneCacheHook kHook = {
+    .is_protected = &IsProtected,
+    .wrap_cache = &WrapCache,
+    .wrap_file = &WrapFile,
+};
+
+}  // namespace
+
+void InstallPaneCacheHook() {
+  disk_cache::SetPaneCacheHook(&kHook);
+}
+
+}  // namespace network::enterprise_encryption
