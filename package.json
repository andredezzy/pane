{
	"name": "pane",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-only",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"lint": "eslint --fix tests && biome check --write --max-diagnostics 500",
		"typecheck": "tsc -p tsconfig.json",
		"test": "scripts/build.sh pane_unittests && \"${CHROMIUM_ROOT:-$HOME/chromium}/src/out/Release/pane_unittests\"",
		"test:asan": "scripts/test-asan.sh",
		"test:runner": "bun test ./tests",
		"knip": "knip"
	},
	"engines": {
		"bun": ">=1.3.9",
		"node": ">=20"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@stylistic/eslint-plugin": "6.0.1",
		"@types/bun": "1.4.4",
		"@types/node": "^26",
		"@typescript-eslint/parser": "^8.73.0",
		"electron": "41.4.0",
		"eslint": "^10.15.0",
		"knip": "6.45.1",
		"typescript": "5.9.3"
	}
}
