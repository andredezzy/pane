{
	"name": "pane",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "eslint --fix && biome check --write --max-diagnostics 500",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"knip": "knip",
		"turbos": "bun scripts/turbos.ts",
		"filter": "bun scripts/filter.ts",
		"postinstall": "test -n \"$CI\" || bun run build"
	},
	"engines": {
		"bun": ">=1.3.9",
		"node": ">=20"
	},
	"overrides": {
		"@types/node": "^22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.2",
		"@stylistic/eslint-plugin": "5.9.0",
		"@types/bun": "1.3.9",
		"@types/node": "^22",
		"@typescript-eslint/eslint-plugin": "^8.37.0",
		"@typescript-eslint/parser": "^8.37.0",
		"eslint": "^9.31.0",
		"knip": "5.80.2",
		"tsdown": "0.19.0-beta.5",
		"turbo": "2.9.6",
		"typescript": "5.9.3"
	}
}
