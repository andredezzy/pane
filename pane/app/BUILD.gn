# Which launch may open which data, and on which Keychain: the user's, or a
# test copy's on the mock keychain (ADR 0012, ADR 0115). A target of its own so
# its tests run in pane_unittests, apart from the engine.

source_set("test_copy") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "test_copy.cc",
    "test_copy.h",
  ]

  deps = [ "//base" ]
}

# The switches every launch hands the engine, and the contract between Pane's
# launch and the Chrome code patched to honor it (ADR 0010). A target of its
# own so its tests run in pane_unittests, apart from the engine.
source_set("engine_switches") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "//pane/common/host.h",
    "engine_switches.cc",
    "engine_switches.h",
  ]

  deps = [ "//base" ]
}

# Pane's own version, as the package carries it: the bundle's PaneVersion on
# the Mac, the pane-version file beside chrome.dll on Windows (ADR 0044). A
# target of its own so Windows' reading is tested in pane_unittests.
source_set("version") {
  visibility = [
    ":unit_tests",
    ":windows_integration",
    "//pane",
  ]

  sources = [
    "version.cc",
    "version.h",
  ]

  if (is_mac) {
    sources += [ "version_mac.cc" ]
    frameworks = [ "CoreFoundation.framework" ]
  }

  if (is_win) {
    sources += [ "version_win.cc" ]
  }

  deps = [ "//base" ]
}

# Pane on Windows' own surfaces (ADR 0127): the registration, the uninstall's
# unregistration and erase, Pane's words through Chromium's installer seam,
# and the shortcuts following the App icon. A target of its own so its tests
# run in pane_unittests.
if (is_win) {
  source_set("windows_integration") {
    visibility = [
      ":unit_tests",
      "//pane",
    ]

    sources = [
      "windows_integration.h",
      "windows_integration_win.cc",
    ]

    deps = [
      ":version",
      "//base",
      "//chrome/install_static:install_static_util",
      "//chrome/installer/util:with_no_strings",
      "//pane/model",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  visibility = [ "//pane/encryption:pane_unittests" ]

  sources = [
    "engine_switches_unittest.cc",
    "test_copy_unittest.cc",
  ]

  # Links, which only the Mac's tests make.
  if (is_mac) {
    sources += [ "test_copy_mac_unittest.cc" ]
  }

  # The version the package writes beside chrome.dll, and Windows' own
  # surfaces.
  if (is_win) {
    sources += [
      "version_win_unittest.cc",
      "windows_integration_win_unittest.cc",
    ]
  }

  deps = [
    ":engine_switches",
    ":test_copy",
    ":version",
    "//base",
    "//base/test:test_support",
    "//components/network_session_configurator/browser",
    "//net",
    "//testing/gtest",
  ]

  if (is_win) {
    deps += [
      ":windows_integration",
      "//chrome/install_static:install_static_util",
      "//chrome/install_static/test:test_support",
      "//chrome/installer/util:with_no_strings",
      "//pane/model",
    ]
  }
}
