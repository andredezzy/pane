# What Chrome's stores hold of a profile, let go of as the profile goes, and
# the background work Chrome left for the thread pool, run first, which a
# lock's detach waits for (ADR 0116). Targets of their own so their tests run
# in pane_unittests, apart from the engine.

source_set("background_work") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "background_work.cc",
    "background_work.h",
  ]

  deps = [ "//base" ]
}

source_set("proto_databases") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "proto_databases.cc",
    "proto_databases.h",
  ]

  deps = [
    "//base",
    "//components/leveldb_proto",
  ]
}

# Pane follows the system's proxy settings without their auto-detection
# (ADR 0040).
source_set("system_proxy") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "system_proxy.cc",
    "system_proxy.h",
  ]

  deps = [
    "//base",
    "//components/prefs",
    "//components/proxy_config",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/mojom",
  ]
}

source_set("unit_tests") {
  testonly = true
  visibility = [ "//pane/encryption:pane_unittests" ]

  sources = [
    "background_work_unittest.cc",
    "proto_databases_unittest.cc",
    "system_proxy_unittest.cc",
  ]

  deps = [
    ":background_work",
    ":proto_databases",
    ":system_proxy",
    "//base",
    "//base/test:test_support",
    "//components/leveldb_proto",
    "//components/leveldb_proto/testing/proto",
    "//components/prefs:test_support",
    "//components/proxy_config",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//net",
    "//net/traffic_annotation:test_support",
    "//pane/encryption:core",
    "//services/network/public/mojom",
    "//testing/gtest",
    "//third_party/leveldatabase",
    "//url",
  ]
}
