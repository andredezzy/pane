# The command table the menu bar and the window's keys share, and the menu
# bar made from it (docs/plans/views-migration.md, H7). A target of its own so
# its tests run in pane_unittests, apart from the engine.

source_set("commands") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "commands.cc",
    "commands.h",
    "menu_bar.cc",
    "menu_bar.h",
  ]

  public_deps = [
    "//base",
    "//ui/base",
    "//ui/menus",
  ]

  deps = [ "//ui/events" ]

  if (is_mac) {
    sources += [
      "commands_mac.cc",
      "menu_bar_mac.mm",
    ]
    frameworks = [ "AppKit.framework" ]
  }

  if (is_win) {
    sources += [
      "commands_win.cc",
      "menu_bar_win.cc",
    ]
  }
}

# The web pages and files a launch of Pane names, as another app hands them
# (ADR 0109). A target of its own so its tests run in pane_unittests.
source_set("handed_pages") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "handed_pages.cc",
    "handed_pages.h",
  ]

  public_deps = [ "//url" ]

  deps = [
    "//base",
    "//components/url_formatter",
  ]
}

# When Pane locks by itself (docs/plans/views-migration.md, L2; ADR 0116):
# Chromium's screen lock, power, and idle time, and the platform's pair for
# what nothing in Chromium hears. A target of its own so its tests run in
# pane_unittests.
source_set("lock_triggers") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "lock_triggers.cc",
    "lock_triggers.h",
  ]

  public_deps = [ "//base" ]

  deps = [ "//ui/base/idle" ]

  if (is_mac) {
    sources += [ "lock_triggers_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }

  if (is_win) {
    sources += [ "lock_triggers_win.cc" ]
    deps += [ "//ui/base" ]
  }
}

source_set("unit_tests") {
  testonly = true
  visibility = [ "//pane/encryption:pane_unittests" ]

  sources = [
    "commands_unittest.cc",
    "handed_pages_unittest.cc",
    "lock_triggers_unittest.cc",
  ]

  deps = [
    ":commands",
    ":handed_pages",
    ":lock_triggers",
    "//base",
    "//base/test:test_support",
    "//net",
    "//testing/gtest",
    "//ui/base",
    "//ui/events",
    "//url",
  ]
}
