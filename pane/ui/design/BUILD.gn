# The design's primitives (docs/plans/views-migration.md, Phase 3), one source
# each, as the Swift app's Theme and Controls had them: the palette and the
# Theme, the squircle, motion, text, Lucide's icons, and the controls' looks.
# A target of its own so their tests run in pane_unittests, apart from the
# engine; it takes nothing of //content's or //chrome's but Chrome's color ids'
# end, after which Pane's start.

source_set("design") {
  visibility = [
    ":unit_tests",
    "//pane",
  ]

  sources = [
    "accessible_layers.cc",
    "accessible_layers.h",
    "anchored_menu.cc",
    "anchored_menu.h",
    "checkbox.cc",
    "checkbox.h",
    "controls.cc",
    "controls.h",
    "dialog.cc",
    "dialog.h",
    "field.cc",
    "field.h",
    "focus_ring.cc",
    "focus_ring.h",
    "icon_button.cc",
    "icon_button.h",
    "icons.cc",
    "icons.h",
    "menu_button.cc",
    "menu_button.h",
    "menu_icon.cc",
    "menu_icon.h",
    "motion.cc",
    "motion.h",
    "palette.cc",
    "palette.h",
    "placement.cc",
    "placement.h",
    "scroll_fade.cc",
    "scroll_fade.h",
    "squircle.cc",
    "squircle.h",
    "switch.cc",
    "switch.h",
    "text.cc",
    "text.h",
    "text_button.cc",
    "text_button.h",
    "theme.cc",
    "theme.h",
    "update_status.cc",
    "update_status.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/color:color_headers",
    "//pane/model",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//ui/views",
  ]

  deps = [
    "//cc/animation",
    "//cc/paint",
    "//ui/accessibility:ax_base",
    "//ui/events",
    "//ui/gfx/animation",
    "//ui/gfx/animation/keyframe",
    "//ui/native_theme",
  ]

  # A menu's template icon, which only the Mac's menus tint, the Mac's
  # selected-text colors, the system's checkbox, AppKit's own cell, and a menu
  # at its anchor, Chromium's own runner's pieces.
  if (is_mac) {
    sources += [
      "anchored_menu_mac.h",
      "anchored_menu_mac.mm",
      "checkbox_mac.mm",
      "menu_icon_mac.mm",
      "palette_mac.mm",
    ]
    deps += [
      "//components/remote_cocoa/app_shim",
      "//components/remote_cocoa/common:mojo",
    ]
    frameworks = [ "AppKit.framework" ]
  }

  # A menu at its anchor, Views' own, the system's checkbox, the native
  # theme's, a menu's icon in the menu's icon color, and the system's
  # highlight.
  if (is_win) {
    sources += [
      "anchored_menu_win.cc",
      "checkbox_win.cc",
      "menu_icon_win.cc",
      "palette_win.cc",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  visibility = [ "//pane/encryption:pane_unittests" ]

  sources = [
    "accessible_layers_unittest.cc",
    "anchored_menu_unittest.cc",
    "controls_unittest.cc",
    "dialog_unittest.cc",
    "icons_unittest.cc",
    "motion_unittest.cc",
    "palette_unittest.cc",
    "placement_unittest.cc",
    "squircle_unittest.cc",
    "text_unittest.cc",
    "theme_unittest.cc",
  ]

  deps = [
    ":design",
    "//base",
    "//base/test:test_support",
    "//cc/paint",
    "//skia",
    "//testing/gtest",
    "//ui/accessibility:test_support",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx:test_support",
    "//ui/gfx/animation",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//ui/views",
  ]

  # The Mac's menu at its anchor, its event and its loop.
  if (is_mac) {
    sources += [ "anchored_menu_mac_unittest.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
}
