# Every file a profile writes is encrypted under a per-profile key that only
# Pane's processes hold in memory (docs/adr/0121): the key registry and the
# formats, which the patched storage layers call. `core` depends on nothing but
# //base and BoringSSL, so //sql, LevelDB, and //services can depend on it.

import("//testing/test.gni")

source_set("core") {
  sources = [
    "engine_keys.cc",
    "engine_keys.h",
    "stream_cipher.cc",
    "stream_cipher.h",
    "whole_file.cc",
    "whole_file.h",
  ]

  deps = [
    "//base",
    "//third_party/boringssl",
  ]
}

source_set("handover") {
  sources = [
    "handover.cc",
    "handover.h",
  ]

  public_deps = [
    ":core",
    "//pane/encryption/public/mojom",
  ]

  deps = [
    ":sqlite",
    "//base",
  ]
}

source_set("sqlite") {
  sources = [
    "sqlite_vfs.cc",
    "sqlite_vfs.h",
  ]

  deps = [
    ":core",
    "//base",
    "//sql",
    "//third_party/boringssl",
    "//third_party/sqlite",
  ]
}

source_set("migration") {
  sources = [
    "profile_migration.cc",
    "profile_migration.h",
  ]

  deps = [
    ":core",
    ":sqlite",
    "//base",
    "//net",
    "//sql",
    "//storage/browser",
    "//storage/common",
    "//url",
  ]
}

test("pane_unittests") {
  testonly = true

  sources = [
    "engine_keys_unittest.cc",
    "leveldb_env_unittest.cc",
    "profile_migration_unittest.cc",
    "sqlite_vfs_unittest.cc",
    "stream_cipher_unittest.cc",
    "whole_file_unittest.cc",
  ]

  deps = [
    ":core",
    ":migration",
    ":sqlite",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//net",
    "//pane/app:unit_tests",
    "//pane/browser:unit_tests",
    "//pane/model:unit_tests",
    "//pane/ui/app:unit_tests",
    "//pane/ui/design:unit_tests",
    "//pane/ui/tabs:unit_tests",
    "//services/network:network_service",
    "//sql",
    "//sql:test_support",
    "//storage/browser",
    "//testing/gtest",
    "//third_party/leveldatabase",
    "//third_party/sqlite",
  ]

  # The Mac's own part of the model: the volume, the wipe, and the paths an
  # earlier Pane on the Mac updates by.
  if (is_mac) {
    deps += [ "//pane/model/mac:unit_tests" ]
  }
}
