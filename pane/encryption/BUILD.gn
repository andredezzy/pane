# Every file a profile writes is encrypted under a per-profile key that only
# Pane's processes hold in memory (docs/adr/0121): the key registry and the
# formats, which the patched storage layers call. `core` depends on nothing but
# //base and BoringSSL, so //sql, LevelDB, and //services can depend on it.

import("//testing/test.gni")

source_set("core") {
  sources = [
    "engine_keys.cc",
    "engine_keys.h",
    "stream_cipher.cc",
    "stream_cipher.h",
    "whole_file.cc",
    "whole_file.h",
  ]

  deps = [
    "//base",
    "//third_party/boringssl",
  ]

  # How each OS names the same folder two ways: its roots' forms, and how a
  # path's names compare.
  if (is_mac) {
    sources += [ "engine_keys_mac.cc" ]
  }
  if (is_win) {
    sources += [ "engine_keys_win.cc" ]
  }
}

# What every process waits for before it drops its keys at a lock: the work
# its thread pool still holds (ADR 0116), the browser's before its detach, the
# network service's and the Storage Service's before their own drops
# (handover's DropKeysOnceBackgroundWorkRan). //base alone, so the services
# can depend on it.
source_set("background_work") {
  visibility = [
    ":*",
    "//pane",
  ]

  sources = [
    "background_work.cc",
    "background_work.h",
  ]

  deps = [ "//base" ]
}

source_set("handover") {
  sources = [
    "handover.cc",
    "handover.h",
  ]

  public_deps = [
    ":core",
    "//pane/encryption/public/mojom",
  ]

  deps = [
    ":background_work",
    ":sqlite",
    "//base",
  ]
}

source_set("sqlite") {
  sources = [
    "sqlite_vfs.cc",
    "sqlite_vfs.h",
  ]

  deps = [
    ":core",
    "//base",
    "//sql",
    "//third_party/boringssl",
    "//third_party/sqlite",
  ]
}

# The conversion of an earlier Pane's profiles (ADR 0121, 0122): the Mac's
# alone, since Windows' first Pane, 0.21.0, wrote today's formats.
source_set("migration") {
  sources = [
    "profile_migration.cc",
    "profile_migration.h",
  ]

  deps = [
    ":core",
    ":sqlite",
    "//base",
    "//net",
    "//sql",
    "//storage/browser",
    "//storage/common",
    "//url",
  ]
}

test("pane_unittests") {
  testonly = true

  sources = [
    "background_work_unittest.cc",
    "engine_keys_unittest.cc",
    "handover_unittest.cc",
    "leveldb_env_unittest.cc",
    "sqlite_vfs_unittest.cc",
    "stream_cipher_unittest.cc",
    "whole_file_unittest.cc",
  ]

  deps = [
    ":background_work",
    ":core",
    ":handover",
    ":sqlite",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//net",
    "//pane/app:unit_tests",
    "//pane/browser:unit_tests",
    "//pane/model:unit_tests",
    "//pane/ui/app:unit_tests",
    "//pane/ui/design:unit_tests",
    "//pane/ui/tabs:unit_tests",
    "//pane/updates:unit_tests",
    "//services/network:network_service",
    "//sql",
    "//sql:test_support",
    "//storage/browser",
    "//testing/gtest",
    "//third_party/leveldatabase",
    "//third_party/sqlite",
  ]

  # The Mac's own part of the model: the volume, the wipe, and the paths an
  # earlier Pane on the Mac updates by, and the conversion of an earlier Pane's
  # profiles, which no Windows Pane has; and each OS's own forms of a root
  # (engine_keys_<os>_unittest.cc).
  if (is_mac) {
    sources += [
      "engine_keys_mac_unittest.cc",
      "profile_migration_unittest.cc",
    ]
    deps += [
      ":migration",
      "//pane/model/mac:unit_tests",
    ]
  }
  if (is_win) {
    sources += [ "engine_keys_win_unittest.cc" ]
    deps += [ "//pane/installer:unit_tests" ]
  }
}
