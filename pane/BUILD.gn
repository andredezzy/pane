# The //pane tree: Pane's embedding layer over Chromium's chrome/ layer, and
# its UI in Views. It is linked into Pane Framework.framework through
# //chrome:chrome_dll; its public/ headers are the Objective-C API the Swift
# app builds against until it goes. On Windows it compiles, not yet links:
# `gn gen out/Win --root-target=//pane` loads it alone (G7).

# A property's ivar and getter come from the compiler, as Objective-C's default:
# Chromium's build asks for them spelled out, which here was 100 lines of nothing.
config("autosynthesized_properties") {
  cflags_objcc = [ "-Wno-objc-missing-property-synthesis" ]
}

source_set("pane") {
  visibility = [ "//chrome:chrome_dll" ]
  configs += [ ":autosynthesized_properties" ]

  sources = [
    "app/engine_switches.cc",
    "app/engine_switches.h",
    "app/pane_main_delegate.cc",
    "app/pane_main_delegate.h",
    "app/views_launch.cc",
    "app/views_launch.h",
    "automation/automation.cc",
    "automation/automation.h",
    "browser/app_callback.cc",
    "browser/app_callback.h",
    "browser/browser_main_extra_parts.h",
    "browser/content_browser_client.cc",
    "browser/content_browser_client.h",
    "browser/engine_trace.cc",
    "browser/extensions/extension_hooks.h",
    "browser/extensions/extension_shortcuts.h",
    "browser/extensions/extension_ui.h",
    "browser/caches_in_memory.cc",
    "browser/caches_in_memory.h",
    "browser/fingerprints.cc",
    "browser/fingerprints.h",
    "browser/profiles.cc",
    "browser/profiles.h",
    "browser/engine_trace.h",
    "browser/ui/devtools_window_host.h",
    "browser/ui/hooks.h",
    "browser/ui/install_hooks.h",
    "browser/ui/select_file_dialog.h",
    "browser/ui/ui_hooks.h",
    "browser/ui/web_contents_delegate.h",
    "browser/ui/window_host.h",
    "browser/site_data.cc",
    "browser/site_data.h",
    "browser/web_store.cc",
    "browser/web_store.h",
    "common/host.cc",
    "common/host.h",
    "ui/design/motion.cc",
    "ui/design/motion.h",
    "ui/render.cc",
    "ui/render.h",
    "ui/interaction_log.cc",
    "ui/interaction_log.h",
    "ui/app/ui_app.cc",
    "ui/app/ui_app.h",
    "ui/tabs/tab_id.cc",
    "ui/tabs/tab_id.h",
    "ui/window/frame.h",
    "ui/window/root_view.cc",
    "ui/window/root_view.h",
    "ui/window/window.cc",
    "ui/window/window.h",
  ]

  # The Swift app's Objective-C API and what drives it, and the Mac's own
  # platform files: none of it builds anywhere else.
  if (is_mac) {
    sources += [
      "browser/browser_application.mm",
      "browser/browser_application_internal.h",
      "browser/browser_context.mm",
      "browser/browser_context_internal.h",
      "browser/browser_main_extra_parts.mm",
      "browser/browser_window_api.mm",
      "browser/cookies.mm",
      "browser/downloads.h",
      "browser/downloads.mm",
      "browser/extensions/action_popup.h",
      "browser/extensions/action_popup.mm",
      "browser/extensions/extension_menu.h",
      "browser/extensions/extension_menu.mm",
      "browser/extensions/extension_shortcuts.mm",
      "browser/extensions/extension_objects.mm",
      "browser/extensions/extension_ui.mm",
      "browser/extensions/extensions_bridge.h",
      "browser/extensions/extensions_bridge.mm",
      "browser/extensions/extensions_internal.h",
      "browser/ui/browser_window.h",
      "browser/ui/browser_window.mm",
      "browser/ui/devtools_window_host.mm",
      "browser/ui/dialogs.mm",
      "browser/ui/dialogs_internal.h",
      "browser/ui/javascript_dialog_manager.h",
      "browser/ui/javascript_dialog_manager.mm",
      "browser/ui/login_handler.h",
      "browser/ui/login_handler.mm",
      "browser/ui/modal_dialog_host.h",
      "browser/ui/modal_dialog_host.mm",
      "browser/ui/permission_prompt.h",
      "browser/ui/permission_prompt.mm",
      "browser/ui/select_file_dialog.mm",
      "browser/ui/tab_bridge.h",
      "browser/ui/tab_bridge.mm",
      "browser/ui/ui_hooks.mm",
      "browser/ui/web_contents_delegate.mm",
      "browser/ui/window_host.mm",
      "browser/web_contents.mm",
      "browser/web_contents_internal.h",
      "ui/interaction_log_mac.mm",
      "ui/window/frame_mac.mm",
      "public/PaneBrowserApplication.h",
      "public/PaneBrowserContext.h",
      "public/PaneBrowserWindow.h",
      "public/PaneCookies.h",
      "public/PaneCore.h",
      "public/PaneDialogs.h",
      "public/PaneExtensions.h",
      "public/PaneExport.h",
      "public/PaneWebContents.h",
    ]
  }

  # gn check passes over //pane (AGENTS.md's gates). chrome/browser/ui/browser.h
  # is included with nogncheck: Chrome keeps its target to its own UI, and
  # Pane's windows host Browsers (ADR 0014).
  deps = [
    "//base",
    "//base/version_info",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/devtools",
    "//chrome/browser/download",
    "//chrome/browser/favicon",
    "//chrome/browser/lifetime:lifetime",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/printing:printing",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/spellchecker:spellchecker",
    "//chrome/browser/ui/autofill:autofill",
    "//chrome/browser/ui/browser_active_state_manager:browser_active_state_manager",
    "//chrome/browser/ui/browser_web_contents_delegate:browser_web_contents_delegate",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/exclusive_access:exclusive_access",
    "//chrome/browser/ui/extensions:extension_popup_types",
    "//chrome/browser/ui/extensions:extensions",
    "//chrome/browser/ui/find_bar:find_bar",
    "//chrome/browser/ui/location_bar:location_bar",
    "//chrome/browser/ui/login:login",
    "//chrome/browser/ui/toolbar:toolbar",
    "//chrome/browser/ui/views/eye_dropper:eye_dropper",
    "//chrome/browser/ui/views/frame:contents_container_view",
    "//chrome/browser/ui/views/interaction:impl",
    # Chromium 157 split the //chrome/browser/ui aggregate into source sets,
    # which //chrome/browser depends on.
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/common",
    "//chrome/common/profiler",
    "//components/autofill/core/common",
    "//components/crx_file",
    "//components/download/content/public",
    "//components/embedder_support",
    "//components/embedder_support:user_agent",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/find_in_page",
    "//components/history/core/common",
    "//components/language/core/browser",
    "//components/password_manager/core/common",
    "//components/permissions",
    "//components/prefs",
    "//components/proxy_config",
    "//components/sessions",
    "//components/signin/public/base",
    "//components/spellcheck/browser",
    "//components/spellcheck/common",
    "//components/spellcheck:buildflags",
    "//components/tabs:public",
    "//components/translate/core/browser",
    "//components/url_formatter",
    "//components/web_modal",
    "//components/zoom",
    "//content/public/browser",
    "//content/public/common",
    "//crypto",
    "//extensions/browser",
    "//extensions/common",
    "//gpu/config",
    "//mojo/public/cpp/bindings",
    "//net",
    "//pane/encryption:handover",
    "//pane/encryption:migration",
    "//printing/buildflags",
    "//skia",
    "//third_party/blink/public/common",
    "//third_party/re2",
    "//ui/base",
    "//ui/compositor",
    "//ui/content_accelerators",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/menus",
    "//ui/shell_dialogs",
    "//ui/views",
    "//ui/views/controls/webview",
    "//url",
  ]

  if (is_mac) {
    deps += [
      "//components/remote_cocoa/app_shim",
      "//components/remote_cocoa/common:mojo",
    ]
    frameworks = [
      "AppKit.framework",
      "Foundation.framework",
    ]
  }
}
