# The ten skies of Pane's icon (ADR 0089), as the Dock shows each, which the
# framework carries in its Resources (base::DIR_ASSETS): packaging/icon/
# make-icons.swift makes them.
if (is_mac) {
  bundle_data("app_icons") {
    sources = [
      "ui/panels/app_icons/AppIconAfterglow.png",
      "ui/panels/app_icons/AppIconClouds.png",
      "ui/panels/app_icons/AppIconDay.png",
      "ui/panels/app_icons/AppIconDusk.png",
      "ui/panels/app_icons/AppIconFuchsia.png",
      "ui/panels/app_icons/AppIconMoonrise.png",
      "ui/panels/app_icons/AppIconMorning.png",
      "ui/panels/app_icons/AppIconNight.png",
      "ui/panels/app_icons/AppIconSunset.png",
      "ui/panels/app_icons/AppIconTwilight.png",
    ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }
