# Pane's model and data, in plain C++ (docs/plans/views-migration.md, Phase
# 2): the formats every Pane wrote, and the rules over them, ported from the
# Swift PaneKit test by test. It depends on //base, //crypto, //url, RE2, ICU,
# and gfx's geometry (its cubic Bézier) alone, so its tests run under the
# sanitizers apart from the engine (pane_model_unittests).

import("//testing/test.gni")

source_set("model") {
  sources = [
    "address_input.cc",
    "address_input.h",
    "app_lock.cc",
    "app_lock.h",
    "app_settings.cc",
    "app_settings.h",
    "browser_model.cc",
    "browser_model.h",
    "client_hints.cc",
    "client_hints.h",
    "crash_loop.cc",
    "crash_loop.h",
    "data_key.cc",
    "data_key.h",
    "data_lock.cc",
    "data_lock.h",
    "data_place.cc",
    "data_place.h",
    "data_vault.cc",
    "data_vault.h",
    "engine_fingerprint.cc",
    "engine_fingerprint.h",
    "engine_folder.h",
    "extension_text.cc",
    "extension_text.h",
    "folder_place.cc",
    "folder_place.h",
    "host_platform.h",
    "local_state.cc",
    "local_state.h",
    "model_store.cc",
    "model_store.h",
    "panic_wipe.cc",
    "panic_wipe.h",
    "panic_wipe_run.cc",
    "panic_wipe_run.h",
    "persisted_file.cc",
    "persisted_file.h",
    "pin_entry.cc",
    "pin_entry.h",
    "pin_guard.h",
    "profile.cc",
    "profile.h",
    "profile_deletions.cc",
    "profile_deletions.h",
    "profile_draft.cc",
    "profile_draft.h",
    "profile_form.cc",
    "profile_form.h",
    "proxy_passwords.cc",
    "proxy_passwords.h",
    "proxy_route.cc",
    "proxy_route.h",
    "reorder.cc",
    "reorder.h",
    "sealed_file.cc",
    "sealed_file.h",
    "security.cc",
    "security.h",
    "sleep_scheduler.cc",
    "sleep_scheduler.h",
    "tab_history.cc",
    "tab_history.h",
    "tab_switcher.cc",
    "tab_switcher.h",
    "test_hooks.cc",
    "test_hooks.h",
    "time_zones.cc",
    "time_zones.h",
    "toolbar_progress.cc",
    "toolbar_progress.h",
    "update_install.cc",
    "update_install.h",
    "updates.cc",
    "updates.h",
    "value_reader.cc",
    "value_reader.h",
    "versions.cc",
    "versions.h",
  ]

  # Each system's own files: the platform Pane runs on, the data's lock, the
  # engine's folder, the wipe's files and processes, and the PIN's guard; on
  # Windows, os_crypt's DPAPI key, the secret the data key is sealed under
  # there (U5).
  if (is_mac) {
    sources += [
      "data_lock_mac.cc",
      "engine_folder_mac.cc",
      "host_platform_mac.cc",
      "panic_wipe_mac.cc",
      "panic_wipe_run_mac.cc",
      "pin_guard_mac.cc",
    ]
  }
  if (is_win) {
    sources += [
      "data_lock_win.cc",
      "engine_folder_win.cc",
      "engine_secret.h",
      "engine_secret_win.cc",
      "host_platform_win.cc",
      "panic_wipe_run_win.cc",
      "panic_wipe_win.cc",
      "pin_guard_win.cc",
    ]
    libs = [
      "crypt32.lib",
      "ncrypt.lib",
    ]
  }

  deps = [
    "//base",
    "//crypto",
    "//third_party/boringssl",
    "//third_party/icu",
    "//third_party/re2",
    "//ui/gfx/geometry",
    "//url",
  ]

  # FileManager's rules, which the Mac's wipe keeps (panic_wipe_mac.cc).
  if (is_mac) {
    deps += [ "//pane/model/mac:file_operations" ]
  }
}

# What the model's tests and the Mac's share: waits on the thread pool's
# work, and a TPM in memory for the PIN's guard.
source_set("test_support") {
  testonly = true

  sources = [
    "stand_in_pin_guard.cc",
    "stand_in_pin_guard.h",
    "test_waits.cc",
    "test_waits.h",
  ]

  deps = [
    ":model",
    "//base",
    "//crypto",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "app_lock_unittest.cc",
    "browser_model_unittest.cc",
    "client_hints_unittest.cc",
    "data_key_unittest.cc",
    "folder_place_unittest.cc",
    "model_store_unittest.cc",
    "persistence_unittest.cc",
    "profile_draft_unittest.cc",
    "proxy_route_unittest.cc",
    "rules_unittest.cc",
    "security_unittest.cc",
    "sleep_scheduler_unittest.cc",
    "tab_switcher_unittest.cc",
    "test_hooks_unittest.cc",
    "toolbar_progress_unittest.cc",
    "updates_unittest.cc",
  ]

  # Windows' own: the engine's folder chrome_elf names, os_crypt's key under
  # DPAPI, and the TPM's guard.
  if (is_win) {
    sources += [
      "engine_folder_win_unittest.cc",
      "engine_secret_win_unittest.cc",
      "pin_guard_win_unittest.cc",
    ]
  }

  # The files the Swift Pane wrote (SwiftVectorsTests.swift), which these read
  # byte for byte.
  data = [ "test_data/" ]

  deps = [
    ":model",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//testing/gtest",
  ]

  # Chromium's own reading of os_crypt's key, and chrome_elf's of the user
  # data dir, which Pane's must be.
  if (is_win) {
    deps += [
      "//chrome/install_static:install_static_util",
      "//components/os_crypt/async/browser",
      "//components/prefs",
      "//components/prefs:test_support",
    ]
  }
}

# The model's tests alone, the Mac's vault's with them, apart from the engine
# and pane_unittests' network stack: what runs under AddressSanitizer, in
# out/ASan (chromium/args/asan.gn, docs/building.md). pane_unittests runs the
# same tests in the release build.
test("pane_model_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]

  if (is_mac) {
    deps += [ "//pane/model/mac:unit_tests" ]
  }
}
