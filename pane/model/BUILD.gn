# Pane's model and data, in plain C++ (docs/plans/views-migration.md, Phase
# 2): the formats every Pane wrote, and the rules over them, ported from the
# Swift PaneKit test by test. It depends on //base, //crypto, //url, RE2, and
# ICU alone, so its tests run under the sanitizers apart from the engine.

source_set("model") {
  sources = [
    "address_input.cc",
    "address_input.h",
    "app_settings.cc",
    "app_settings.h",
    "client_hints.cc",
    "client_hints.h",
    "crash_loop.cc",
    "crash_loop.h",
    "data_key.cc",
    "data_key.h",
    "engine_fingerprint.cc",
    "engine_fingerprint.h",
    "extension_shortcut.cc",
    "extension_shortcut.h",
    "extension_text.cc",
    "extension_text.h",
    "local_state.cc",
    "local_state.h",
    "persisted_file.cc",
    "persisted_file.h",
    "profile.cc",
    "profile.h",
    "profile_deletions.cc",
    "profile_deletions.h",
    "profile_form.cc",
    "profile_form.h",
    "proxy_passwords.cc",
    "proxy_passwords.h",
    "proxy_route.cc",
    "proxy_route.h",
    "reorder.cc",
    "reorder.h",
    "sealed_file.cc",
    "sealed_file.h",
    "security.cc",
    "security.h",
    "tab_history.cc",
    "tab_history.h",
    "tab_switcher.cc",
    "tab_switcher.h",
    "time_zones.cc",
    "time_zones.h",
    "update_install.cc",
    "update_install.h",
    "updates.cc",
    "updates.h",
    "value_reader.cc",
    "value_reader.h",
    "versions.cc",
    "versions.h",
  ]

  deps = [
    "//base",
    "//crypto",
    "//third_party/boringssl",
    "//third_party/icu",
    "//third_party/re2",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "client_hints_unittest.cc",
    "data_key_unittest.cc",
    "persistence_unittest.cc",
    "proxy_route_unittest.cc",
    "rules_unittest.cc",
    "security_unittest.cc",
    "tab_switcher_unittest.cc",
    "updates_unittest.cc",
  ]

  # The files the Swift Pane wrote (SwiftVectorsTests.swift), which these read
  # byte for byte.
  data = [ "test_data/" ]

  deps = [
    ":model",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//testing/gtest",
    "//url",
  ]
}
