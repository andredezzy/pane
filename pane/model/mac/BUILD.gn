# The Mac's own part of Pane's model (docs/plans/views-migration.md, Phase 2,
# C4 and C6), ported from the Swift PaneKit test by test: the encrypted
# volume, the vault's place in it, what the panic wipe takes besides the data,
# and the paths every earlier Pane on the Mac updates by (ADR 0122); the
# Keychain's secret through Chromium's own code, and the volume's watchdog.
# The lock, the vault's sequences, the data's lock, and the wipe's order are
# //pane/model's, shared with Windows (W3). No Pane ever ran on Windows (U5),
# so none of this builds there.

assert(is_mac)

# OpenBSD's bcrypt, copied unmodified (third_party/openbsd-bcrypt): these
# defines stand in for OpenBSD's libc internals, so the files stay as they
# came. Only the check is called (VerifyPinHash); the test makes hashes.
config("bcrypt_config") {
  visibility = [ ":*" ]
  include_dirs = [ "bcrypt" ]
  defines = [
    "DEF_WEAK(x)=",
    "WRAP(x)=x",
    "explicit_bzero(p,n)=memset_s(p,n,0,n)",
    "__STDC_WANT_LIB_EXT1__=1",
  ]

  # OpenBSD's libc builds it without -Wpointer-sign: its char and u_int8_t
  # strings mix as they are.
  cflags = [ "-Wno-pointer-sign" ]
}

source_set("bcrypt") {
  visibility = [ ":*" ]
  sources = [
    "bcrypt/bcrypt.c",
    "bcrypt/bcrypt.h",
    "bcrypt/blf.h",
    "bcrypt/blowfish.c",
  ]

  # Third-party C, kept as it came: the unsafe-buffer check, which Chromium
  # leaves out of third_party/ by its path, is left out here too.
  configs -= [
    "//build/config/clang:unsafe_buffers",
    "//build/config/compiler:chromium_code",
  ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":bcrypt_config",
  ]
}

# What the Swift ported here asked of Foundation's FileManager and URL: the
# volume, the moves of an earlier Pane's data, and the Mac's half of the
# panic wipe's files (//pane/model's panic_wipe_mac.cc) run on it.
source_set("file_operations") {
  visibility = [
    ":*",
    "//pane/model",
  ]

  sources = [
    "file_operations.cc",
    "file_operations.h",
  ]

  deps = [ "//base" ]
}

source_set("mac") {
  sources = [
    "bundle_identifier.cc",
    "bundle_identifier.h",
    "data_volume.cc",
    "data_volume.h",
    "electron_migration.cc",
    "electron_migration.h",
    "launch_alert.cc",
    "launch_alert.h",
    "launch_migration.cc",
    "launch_migration.h",
    "pin_hash.cc",
    "pin_hash.h",
    "proxy_password_store.cc",
    "proxy_password_store.h",
    "proxy_password_vault.cc",
    "proxy_password_vault.h",
    "safe_storage.h",
    "safe_storage.mm",
    "volume_place.cc",
    "volume_place.h",
    "wipe_sources.cc",
    "wipe_sources.h",
  ]

  public_deps = [ ":file_operations" ]

  deps = [
    ":bcrypt",
    "//base",
    "//components/os_crypt/common:keychain_password_mac",
    "//components/os_crypt/common:switches",
    "//crypto",
    "//pane/model",
  ]

  frameworks = [
    "CoreFoundation.framework",
    "DiskArbitration.framework",
    "Foundation.framework",
    "LocalAuthentication.framework",
    "Security.framework",
  ]
}

# The volume's watchdog (ADR 0113): it detaches the encrypted volume once
# Pane's process ends, a crash included. package.sh puts it in the app
# bundle's Contents/MacOS, beside the loader, where DataVault::WatchdogPath
# finds it.
executable("pane-volume-watch") {
  sources = [ "volume_watch_main.cc" ]

  deps = [
    ":mac",
    "//base",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "app_lock_unittest.cc",
    "bundle_identifier_unittest.cc",
    "data_lock_unittest.cc",
    "data_vault_unittest.cc",
    "data_volume_unittest.cc",
    "electron_migration_unittest.cc",
    "panic_wipe_run_unittest.cc",
    "panic_wipe_unittest.cc",
    "pin_hash_unittest.cc",
    "proxy_password_store_unittest.cc",
    "proxy_password_vault_unittest.cc",
    "safe_storage_unittest.cc",
    "test_keychain.h",
    "test_keychain.mm",
    "vault_test_support.cc",
    "vault_test_support.h",
    "volume_watch_unittest.cc",
  ]

  # The watchdog the volume's tests run, built beside them.
  data_deps = [ ":pane-volume-watch" ]

  deps = [
    ":bcrypt",
    ":mac",
    "//base",
    "//base/test:test_support",
    "//components/os_crypt/common:keychain_password_mac",
    "//crypto",
    "//pane/model",
    "//pane/model:test_support",
    "//testing/gtest",
  ]

  frameworks = [
    "CoreFoundation.framework",
    "Foundation.framework",
    "Security.framework",
  ]
}
