{
	"$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**/*"]
	},
	"formatter": {
		"enabled": true,
		"includes": ["**/*"],
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"includes": ["**/*"],
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				},
				"noUnusedVariables": {
					"level": "error",
					"fix": "none"
				}
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noUselessConstructor": "off"
			},
			"suspicious": {
				"noDocumentCookie": "off",
				"noExplicitAny": "error",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["log", "error", "warn", "info", "debug"]
					}
				}
			},
			"style": {
				"useImportType": "off",
				"useBlockStatements": "error",
				"noNestedTernary": "error",
				"useConst": "error",
				"useTemplate": "error",
				"useExponentiationOperator": "error",
				"noParameterAssign": "warn"
			},
			"performance": {
				"noBarrelFile": "warn",
				"noReExportAll": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/generated/**", "**/*.generated.*"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"includes": ["**/*"],
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
