{
	"manifest_version": 3,
	"name": "Pane commands probe",
	"version": "1.0",
	"description": "Declares keyboard shortcuts (chrome.commands) for Pane's scenarios.",
	"action": { "default_title": "Commands probe" },
	"background": { "service_worker": "worker.js" },
	"permissions": ["storage"],
	"commands": {
		"probe-command": {
			"suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
			"description": "Run the probe's command"
		},
		"_execute_action": {
			"suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" }
		}
	}
}
