# Release build of the engine. Kept identical between the stock build and the
# PaneCore build so the two only differ by the patch series and //pane.
is_debug = false
dcheck_always_on = false
symbol_level = 1
target_cpu = "arm64"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Pane's names, in //pane (ADR 0009).
branding_file_path = "//pane/BRANDING"
# Chromium's testing field trials (testing/variations) stay off: they switch on
# experimental features (Omnibox Everywhere's menu bar item, among others), and
# Pane ships Chromium's defaults, as official builds do.
disable_fieldtrial_testing_config = true
# Profile-guided optimization from Chrome's own profile for this branch, as
# Chrome's releases are built (sync.sh fetches it). It needs no official
# build; ThinLTO, which is_official_build turns on, waits for its link to be
# timed (docs/plans/views-migration.md, B6).
chrome_pgo_phase = 2
