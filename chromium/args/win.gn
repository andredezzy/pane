# The Windows engine, cross-built from the Mac (ADR 0124's U6): release.gn's
# args for x64. scripts/build.sh builds it with PANE_BUILD_PLATFORM=windows-x64,
# and scripts/compile-windows.sh compiles //pane's objects in it before each
# push.
is_debug = false
dcheck_always_on = false
symbol_level = 1
target_os = "win"
target_cpu = "x64"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
branding_file_path = "//pane/BRANDING"
disable_fieldtrial_testing_config = true
