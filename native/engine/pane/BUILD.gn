# The //pane tree: Pane's embedding layer over Chromium's chrome/ layer. It is
# linked into PaneCore.framework through //chrome:chrome_dll, and its public/
# headers are the Objective-C API the Pane app builds against.

assert(is_mac, "PaneCore is macOS only.")

