{
	"name": "@pane/veil",
	"version": "0.2.3",
	"description": "Multi-profile desktop browser with per-profile proxies and Chrome extension support.",
	"author": "André Victor <contact@andredezzy.com>",
	"license": "GPL-3.0-only",
	"private": true,
	"type": "commonjs",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"pack": "rm -rf release && electron-builder --dir",
		"dist": "rm -rf release && electron-builder"
	},
	"dependencies": {
		"@dnd-kit/abstract": "0.4.0",
		"@dnd-kit/dom": "0.4.0",
		"@dnd-kit/react": "0.4.0",
		"@hookform/resolvers": "5.2.2",
		"@pane/electron-chrome-context-menu": "workspace:*",
		"@pane/electron-chrome-extensions": "workspace:*",
		"@pane/ui": "workspace:*",
		"@trpc/client": "^11",
		"@trpc/server": "^11",
		"@types/ws": "8.18.1",
		"bcryptjs": "3.0.3",
		"electron-chrome-web-store": "0.13.0",
		"lucide-react": "^0.542.0",
		"react": "^19",
		"react-dom": "^19",
		"react-hook-form": "7.74.0",
		"socks": "2.8.9",
		"trpc-electron": "0.1.2",
		"ws": "8.21.0",
		"zod": "4.3.6",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@pane/config-test": "workspace:*",
		"@pane/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "^4",
		"@types/bcryptjs": "3.0.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4",
		"electron": "41.4.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^3.1.0",
		"postcss": "^8",
		"tailwindcss": "^4",
		"tw-animate-css": "1.4.0",
		"vite": "^6",
		"vitest": "^4.0.16"
	},
	"build": {
		"appId": "com.pane.desktop",
		"productName": "Pane",
		"electronFuses": {
			"runAsNode": false,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false,
			"onlyLoadAppFromAsar": true,
			"enableEmbeddedAsarIntegrityValidation": true
		},
		"directories": {
			"buildResources": "resources",
			"output": "release"
		},
		"files": [
			"out/**/*"
		],
		"asarUnpack": [
			"node_modules/@pane/electron-chrome-extensions/dist/preloads/**",
			"node_modules/@pane/electron-chrome-extensions/dist/chrome-extension-api.preload.js"
		],
		"mac": {
			"target": "dmg",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"dmg": {
			"contents": [
				{
					"x": 130,
					"y": 150
				},
				{
					"x": 410,
					"y": 150,
					"type": "link",
					"path": "/Applications"
				},
				{
					"x": 270,
					"y": 300,
					"type": "file",
					"path": "resources/Install Pane.command"
				}
			]
		},
		"win": {
			"target": "nsis",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"linux": {
			"target": "AppImage",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		}
	}
}
