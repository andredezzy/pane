{
	"name": "@pane/veil",
	"version": "0.0.1",
	"private": true,
	"type": "commonjs",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"typecheck": "tsc --noEmit",
		"pack": "rm -rf release && electron-builder --dir",
		"dist": "rm -rf release && electron-builder"
	},
	"dependencies": {
		"@dnd-kit/abstract": "0.4.0",
		"@dnd-kit/dom": "0.4.0",
		"@dnd-kit/react": "0.4.0",
		"@hookform/resolvers": "5.2.2",
		"@pane/electron-chrome-extensions": "workspace:*",
		"@pane/ui": "workspace:*",
		"@trpc/client": "^11",
		"@trpc/server": "^11",
		"bcryptjs": "3.0.3",
		"electron-chrome-web-store": "0.13.0",
		"lucide-react": "^0.542.0",
		"react": "^19",
		"react-dom": "^19",
		"react-hook-form": "7.74.0",
		"trpc-electron": "0.1.2",
		"zod": "4.3.6",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@pane/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "^4",
		"@types/bcryptjs": "3.0.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4",
		"electron": "41.4.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^3.1.0",
		"postcss": "^8",
		"tailwindcss": "^4",
		"tw-animate-css": "1.4.0",
		"vite": "^6"
	},
	"build": {
		"appId": "com.pane.desktop",
		"productName": "Pane",
		"electronFuses": {
			"runAsNode": false,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false,
			"onlyLoadAppFromAsar": true,
			"enableEmbeddedAsarIntegrityValidation": true
		},
		"directories": {
			"buildResources": "resources",
			"output": "release"
		},
		"files": [
			"out/**/*"
		],
		"asarUnpack": [
			"node_modules/@pane/electron-chrome-extensions/dist/preloads/**",
			"node_modules/@pane/electron-chrome-extensions/dist/chrome-extension-api.preload.js"
		],
		"extraResources": [
			{
				"from": "extensions",
				"to": "extensions"
			},
			{
				"from": "resources/shim-preload.js",
				"to": "shim-preload.js"
			}
		],
		"mac": {
			"target": "dmg",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"win": {
			"target": "nsis",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"linux": {
			"target": "AppImage",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		}
	}
}
