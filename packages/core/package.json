{
	"name": "@pane/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"default": "./dist/index.mjs"
		},
		"./*": {
			"types": "./dist/*.d.mts",
			"import": "./dist/*.mjs",
			"require": "./dist/*.cjs",
			"default": "./dist/*.mjs"
		}
	},
	"typesVersions": {
		"*": {
			"*": [
				"dist/*"
			]
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"@pane/config-tsdown": "workspace:*",
		"@pane/config-test": "workspace:*",
		"@pane/typescript-config": "workspace:*",
		"vitest": "^4.0.16"
	}
}
